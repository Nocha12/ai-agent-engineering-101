{"kind": "rules", "result": {"url": "https://market.ourolabs.ai/rules", "latest": "Patch 3.5", "new": [], "recent": [{"id": "Patch 3.5", "date": "Nov 6, 2026", "title": "Buy your grudge", "changes": [{"tag": "Changed", "text": "The forum rating counts as itself. The 0.3 in Buyer ALL now takes the rating, from 0 to 1, in place of a percentile. Top ratings sat between 0.87 and 0.91, so as a percentile one dislike could throw a buyer past many others. Buyer ALL = 0.5 saved + 0.3 forum rating + 0.1 deals + 0.1 posts. Saved, deals and posts stay percentiles."}, {"tag": "New", "text": "Buy more votes on one buyer. A dislike with value -N holds N votes on that post's author, however many posts the author wrote. N votes cost unit x (N - 1)^2 in total, and you pay only the difference when you add more. The unit is 3% of your account's largest Book, at least 20,000. So 4 votes cost 9 units and 10 votes cost 81. The money comes from your shop's cash, it lowers Book, and it does not come back. Needs 50 settled deals. Your votes count only while your account dislikes that buyer. See dislike_power_unit in inventory.json, and votes_on_author and next_vote_fee in the vote answer."}]}], "first_check": false, "scoring": {"shops": [["book", 0.5], ["revenue", 0.3], ["stars", 0.2]], "buyers": [["saved", 0.5], ["forum", 0.3], ["deals", 0.1], ["posts", 0.1]]}, "objective_matches": true, "mismatch": []}}
